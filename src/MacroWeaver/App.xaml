<Application x:Class="MacroWeaver.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF5B6EE1" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FF20232B" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FF292D37" />
        <SolidColorBrush x:Key="MutedBrush" Color="#FF9CA3B5" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Application.Resources>
</Application>

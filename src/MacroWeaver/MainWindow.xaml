<Window x:Class="MacroWeaver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MacroWeaver" Height="760" Width="1240" MinHeight="620" MinWidth="980"
        WindowStartupLocation="CenterScreen" Background="#FF17191F" Foreground="#FFF3F4F8" PreviewKeyDown="MainWindow_PreviewKeyDown">
    <Window.Resources>
        <ContextMenu x:Key="StepContextMenu">
            <MenuItem Header="↑ 上へ移動" Click="MoveUp_Click" />
            <MenuItem Header="↓ 下へ移動" Click="MoveDown_Click" />
            <Separator />
            <MenuItem Header="コピー (Ctrl+C)" Click="Copy_Click" />
            <MenuItem Header="貼り付け (Ctrl+V)" Click="Paste_Click" />
            <MenuItem Header="⧉ 複製" Click="Duplicate_Click" />
            <MenuItem Header="↳ 選択した操作を繰り返しに入れる..." Click="MoveIntoRepeat_Click" />
            <MenuItem Header="－ 削除" Click="Delete_Click" />
        </ContextMenu>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FF20232B" CornerRadius="12" Padding="16" Margin="0,0,0,12">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="使用するマクロ" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource MutedBrush}" />
                    <ComboBox x:Name="MacroSelector" Width="190" VerticalContentAlignment="Center"
                              ItemsSource="{Binding MacroLibrary}" DisplayMemberPath="Name"
                              SelectionChanged="MacroSelector_SelectionChanged" />
                    <Button Content="＋ 新規" Click="NewMacro_Click" />
                    <Button Content="名前変更" Click="RenameMacro_Click" />
                    <Button Content="💾 保存" Click="Save_Click" Background="#FF5B6EE1" Foreground="White" />
                    <Button Content="削除" Click="DeleteMacro_Click" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="MacroWeaver" FontSize="24" FontWeight="Bold" />
                    <TextBlock Text="マクロをアプリ内で管理・選択できるエディター" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#FF20232B" CornerRadius="12" Padding="12" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="4,4,4,12">
                        <TextBlock Text="ブロック一覧" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="ブロックをドラッグして右側へ配置" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False" PanningMode="VerticalOnly">
                        <StackPanel>
                            <Button Content="⌨  キー入力" Background="#FF8554C8" Foreground="White" Tag="KeyPress" PreviewMouseMove="PaletteButton_PreviewMouseMove" Click="AddKey_Click" HorizontalContentAlignment="Left" />
                            <Button Content="🖱  マウスクリック" Background="#FFD65C83" Foreground="White" Tag="MouseClick" PreviewMouseMove="PaletteButton_PreviewMouseMove" Click="AddClick_Click" HorizontalContentAlignment="Left" />
                            <Button Content="↗  マウス移動（座標）" Background="#FF4C97FF" Foreground="White" Tag="MouseMove" PreviewMouseMove="PaletteButton_PreviewMouseMove" Click="AddMove_Click" HorizontalContentAlignment="Left" />
                            <Button Content="↔  マウス相対移動（視点操作）" Background="#FF4C97FF" Foreground="White" Tag="MouseMoveRelative" PreviewMouseMove="PaletteButton_PreviewMouseMove" Click="AddRelativeMove_Click" HorizontalContentAlignment="Left" />
                            <Button Content="↕  マウスホイール" Background="#FF4CBFE6" Foreground="White" Tag="MouseScroll" PreviewMouseMove="PaletteButton_PreviewMouseMove" Click="AddScroll_Click" HorizontalContentAlignment="Left" />
                            <Button Content="⏱  待機" Background="#FFFFAB19" Foreground="#FF302713" Tag="Wait" PreviewMouseMove="PaletteButton_PreviewMouseMove" Click="AddWait_Click" HorizontalContentAlignment="Left" />
                            <Button Content="🎲  ランダム待機" Background="#FFFFAB19" Foreground="#FF302713" Tag="RandomWait" PreviewMouseMove="PaletteButton_PreviewMouseMove" Click="AddRandomWait_Click" HorizontalContentAlignment="Left" />
                            <Button Content="🔁  繰り返し" Background="#FFFFBF00" Foreground="#FF302713" Tag="Repeat" PreviewMouseMove="PaletteButton_PreviewMouseMove" Click="AddRepeat_Click" HorizontalContentAlignment="Left" />
                            <CheckBox x:Name="AddAtRootCheck" Content="最上位に追加（繰り返しの外）" Foreground="#FFF3F4F8" Margin="4,4,4,10" ToolTip="チェックすると、選択中の繰り返しの内部ではなく、最上位の手順に追加します。" />
                            <Separator Margin="3,12" />
                            <Button Content="↑  上へ移動" Click="MoveUp_Click" HorizontalContentAlignment="Left" />
                            <Button Content="↓  下へ移動" Click="MoveDown_Click" HorizontalContentAlignment="Left" />
                            <Button Content="コピー (Ctrl+C)" Click="Copy_Click" HorizontalContentAlignment="Left" />
                            <Button Content="貼り付け (Ctrl+V)" Click="Paste_Click" HorizontalContentAlignment="Left" />
                            <Button Content="⧉  複製" Click="Duplicate_Click" HorizontalContentAlignment="Left" />
                            <Button Content="↶ 戻る (Ctrl+Z)" Click="Undo_Click" HorizontalContentAlignment="Left" />
                            <Button Content="↷ 進む (Ctrl+Y)" Click="Redo_Click" HorizontalContentAlignment="Left" />
                            <Button Content="－  削除" Click="Delete_Click" HorizontalContentAlignment="Left" />
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock Grid.Row="2" Text="操作を選択すると、右側で詳細を編集できます。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="4,12,4,4" />
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="#FF20232B" CornerRadius="12" Padding="12" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,4,4,12">
                        <TextBlock Text="ブロックエリア" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock x:Name="StepCountText" Text="0 操作" Foreground="{StaticResource MutedBrush}" Margin="12,2,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="繰り返し左の −／＋ で内部を折りたたみ・展開できます" Foreground="#FF9CA8C2" FontSize="11" Margin="14,3,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <DataGrid Grid.Row="1" x:Name="StepsGrid" AllowDrop="True" PreviewMouseMove="StepsGrid_PreviewMouseMove" PreviewMouseLeftButtonUp="StepsGrid_PreviewMouseLeftButtonUp" DragOver="StepsGrid_DragOver" Drop="StepsGrid_Drop" ItemsSource="{Binding VisibleSteps}" SelectedItem="{Binding SelectedStep, Mode=TwoWay}"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              SelectionMode="Extended" SelectionUnit="FullRow" GridLinesVisibility="None"
                              HeadersVisibility="Column" Background="#FF292D37" Foreground="#FFF3F4F8"
                              BorderThickness="0" RowBackground="#FF292D37" AlternatingRowBackground="#FF252832"
                              HorizontalGridLinesBrush="#FF3A3E49" VerticalGridLinesBrush="#FF3A3E49"
                              SelectionChanged="StepsGrid_SelectionChanged">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#FF343844" />
                                <Setter Property="Foreground" Value="#FFE5E7EF" />
                                <Setter Property="Padding" Value="10,9" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Setter Property="MinHeight" Value="76" />
                                <Setter Property="Margin" Value="10,0,12,0" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="BorderBrush" Value="#FF20232B" />
                                <Setter Property="Background" Value="{Binding BlockColor}" />
                                <Setter Property="Foreground" Value="#FFF3F4F8" />
                                <Setter Property="FontWeight" Value="Normal" />
                                <Setter Property="SnapsToDevicePixels" Value="True" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type DataGridRow}">
                                            <Grid SnapsToDevicePixels="True">
                                                <!-- Scratch風の上下ノッチとタブを持つブロック形状 -->
                                                <Path x:Name="BlockSurface"
                                                      Data="M 0,0 H 34 C 34,0 34,8 42,8 C 50,8 50,0 50,0 H 100 V 68 H 50 C 50,68 50,76 42,76 C 34,76 34,68 34,68 H 0 Z"
                                                      Stretch="Fill"
                                                      Fill="{TemplateBinding Background}"
                                                      Stroke="{TemplateBinding BorderBrush}"
                                                      StrokeThickness="1"
                                                      IsHitTestVisible="False" />
                                                <SelectiveScrollingGrid>
                                                    <SelectiveScrollingGrid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </SelectiveScrollingGrid.ColumnDefinitions>
                                                    <SelectiveScrollingGrid.RowDefinitions>
                                                        <RowDefinition Height="*" />
                                                    </SelectiveScrollingGrid.RowDefinitions>
                                                    <DataGridRowHeader Grid.Column="0" Visibility="Collapsed" />
                                                    <DataGridCellsPresenter Grid.Column="1"
                                                                            ItemsPanel="{TemplateBinding ItemsPanel}"
                                                                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                                </SelectiveScrollingGrid>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <EventSetter Event="PreviewMouseRightButtonDown" Handler="StepsGridRow_PreviewMouseRightButtonDown" />
                                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="StepsGridRow_PreviewMouseLeftButtonDown" />
                                <Setter Property="ContextMenu" Value="{StaticResource StepContextMenu}" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#FF46516F" />
                                        <Setter Property="BorderBrush" Value="#FF91A7FF" />
                                        <Setter Property="BorderThickness" Value="2" />
                                        <Setter Property="Foreground" Value="#FFFFFFFF" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding RepeatDepth}" Value="1">
                                        <Setter Property="Margin" Value="20,1,12,1" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RepeatDepth}" Value="2">
                                        <Setter Property="Margin" Value="28,1,12,1" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RepeatDepth}" Value="3">
                                        <Setter Property="Margin" Value="36,1,12,1" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RepeatDepth}" Value="4">
                                        <Setter Property="Margin" Value="44,1,12,1" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RepeatDepth}" Value="5">
                                        <Setter Property="Margin" Value="52,1,12,1" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RepeatDepth}" Value="6">
                                        <Setter Property="Margin" Value="60,1,12,1" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RepeatDepth}" Value="7">
                                        <Setter Property="Margin" Value="68,1,12,1" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RepeatDepth}" Value="8">
                                        <Setter Property="Margin" Value="76,1,12,1" />
                                    </DataTrigger>
                                    <!-- Repeat body: a continuous yellow rail on the left. -->
                                    <DataTrigger Binding="{Binding IsInsideRepeat}" Value="True">
                                        <Setter Property="BorderBrush" Value="#FFFFD54F" />
                                        <Setter Property="BorderThickness" Value="4,0,0,0" />
                                    </DataTrigger>
                                    <!-- The repeat header draws the top edge and starts the left rail. -->
                                    <DataTrigger Binding="{Binding TypeLabel}" Value="🔁 繰り返し">
                                        <Setter Property="Background" Value="#FFFFD54F" />
                                        <Setter Property="Foreground" Value="#FF302713" />
                                        <Setter Property="BorderBrush" Value="#FFFFD54F" />
                                        <Setter Property="BorderThickness" Value="4,4,0,0" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                    <!-- The final child draws the bottom edge: start and end use the same yellow. -->
                                    <DataTrigger Binding="{Binding IsRepeatEnd}" Value="True">
                                        <Setter Property="Background" Value="#FFFFD54F" />
                                        <Setter Property="Foreground" Value="#FF302713" />
                                        <Setter Property="BorderBrush" Value="#FFFFD54F" />
                                        <Setter Property="BorderThickness" Value="4,0,0,4" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsRepeatEnd}" Value="True" />
                                            <Condition Binding="{Binding TypeLabel}" Value="🔁 繰り返し" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="BorderThickness" Value="4,4,0,4" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="8,4" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <!-- Shape is drawn by the row Path; cells must not cover it. -->
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Foreground" Value="#FFF3F4F8" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="#FFFFFFFF" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="34">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding ExpandGlyph}" IsEnabled="{Binding IsRepeat}" Click="ToggleRepeat_Click"
                                                Padding="2,0" MinWidth="24" MinHeight="24" ToolTip="繰り返しの内部を展開／折りたたみ" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="#" Binding="{Binding OrderLabel}" Width="44" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="ブロック" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TypeLabel}" FontWeight="Bold" FontSize="11"
                                                   Foreground="White" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" MaxHeight="52" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="名前" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            <DataGridTextColumn Header="設定" Binding="{Binding Summary}" Width="190" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="MaxHeight" Value="52" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="#FF20232B" CornerRadius="12" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="プロパティ" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14" />
                        <TextBlock Text="操作名" Foreground="{StaticResource MutedBrush}" />
                        <TextBox x:Name="NameBox" Margin="0,5,0,14" Padding="8" TextChanged="Property_Changed" />

                        <StackPanel x:Name="KeyPanel" Visibility="Collapsed">
                            <TextBlock Text="キー" Foreground="{StaticResource MutedBrush}" />
                            <TextBox x:Name="KeyBox" Margin="0,5,0,12" Padding="8" Text="A" TextChanged="Property_Changed" />
                            <TextBlock Text="押下時間（秒）" Foreground="{StaticResource MutedBrush}" />
                            <TextBox x:Name="KeySecondsBox" Margin="0,5,0,12" Padding="8" Text="0.1" TextChanged="Property_Changed" />
                        </StackPanel>

                        <StackPanel x:Name="ClickPanel" Visibility="Collapsed">
                            <TextBlock Text="マウスボタン" Foreground="{StaticResource MutedBrush}" />
                            <ComboBox x:Name="MouseButtonBox" Margin="0,5,0,12" Padding="6" SelectionChanged="Property_SelectionChanged">
                                <ComboBoxItem Content="Left" />
                                <ComboBoxItem Content="Right" />
                                <ComboBoxItem Content="Middle" />
                            </ComboBox>
                            <TextBlock Text="クリック回数" Foreground="{StaticResource MutedBrush}" />
                            <TextBox x:Name="ClickCountBox" Margin="0,5,0,12" Padding="8" Text="1" TextChanged="Property_Changed" />
                        </StackPanel>

                        <StackPanel x:Name="MovePanel" Visibility="Collapsed">
                            <TextBlock Text="X 座標" Foreground="{StaticResource MutedBrush}" />
                            <TextBox x:Name="XBox" Margin="0,5,0,12" Padding="8" Text="500" TextChanged="Property_Changed" />
                            <TextBlock Text="Y 座標" Foreground="{StaticResource MutedBrush}" />
                            <TextBox x:Name="YBox" Margin="0,5,0,12" Padding="8" Text="300" TextChanged="Property_Changed" />
                        </StackPanel>

                        <StackPanel x:Name="RelativeMovePanel" Visibility="Collapsed">
                            <TextBlock Text="相対 X 移動量（ΔX）" Foreground="{StaticResource MutedBrush}" />
                            <TextBox x:Name="RelativeXBox" Margin="0,5,0,12" Padding="8" Text="10" TextChanged="Property_Changed" />
                            <TextBlock Text="相対 Y 移動量（ΔY）" Foreground="{StaticResource MutedBrush}" />
                            <TextBox x:Name="RelativeYBox" Margin="0,5,0,12" Padding="8" Text="0" TextChanged="Property_Changed" />
                            <TextBlock Text="ゲームの視点操作向けです。正の X は右、正の Y は下方向への相対移動です。ゲームによっては合成入力を受け付けない場合があります。"
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        </StackPanel>

                        <StackPanel x:Name="ScrollPanel" Visibility="Collapsed">
                            <TextBlock Text="ホイール移動量" Foreground="{StaticResource MutedBrush}" />
                            <TextBox x:Name="ScrollDeltaBox" Margin="0,5,0,12" Padding="8" Text="120" TextChanged="Property_Changed" />
                            <TextBlock Text="正の値は上方向、負の値は下方向です。通常は 120 が1ノッチ相当です。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        </StackPanel>

                        <StackPanel x:Name="WaitPanel" Visibility="Collapsed">
                            <TextBlock Text="待機時間（秒）" Foreground="{StaticResource MutedBrush}" />
                            <TextBox x:Name="WaitSecondsBox" Margin="0,5,0,12" Padding="8" Text="1" TextChanged="Property_Changed" />
                        </StackPanel>

                        <StackPanel x:Name="RandomWaitPanel" Visibility="Collapsed">
                            <TextBlock Text="最短待機時間（秒）" Foreground="{StaticResource MutedBrush}" />
                            <TextBox x:Name="RandomWaitMinBox" Margin="0,5,0,12" Padding="8" Text="1" TextChanged="Property_Changed" />
                            <TextBlock Text="最長待機時間（秒）" Foreground="{StaticResource MutedBrush}" />
                            <TextBox x:Name="RandomWaitMaxBox" Margin="0,5,0,12" Padding="8" Text="3" TextChanged="Property_Changed" />
                            <TextBlock Text="実行するたびに、指定した最短～最長の範囲から待機時間をランダムに選びます。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        </StackPanel>

                        <StackPanel x:Name="RepeatPanel" Visibility="Collapsed">
                            <TextBlock Text="繰り返し方法" Foreground="{StaticResource MutedBrush}" />
                            <CheckBox x:Name="RepeatDurationCheck" Content="時間指定で繰り返す" Foreground="#FFFFFFFF" FontWeight="SemiBold" Background="Transparent" Margin="0,5,0,8" Checked="RepeatDurationCheck_Changed" Unchecked="RepeatDurationCheck_Changed" />
                            <StackPanel x:Name="RepeatCountSettings">
                                <TextBlock Text="繰り返し回数（0 = 無限）" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                <TextBox x:Name="RepeatCountBox" Margin="0,5,0,12" Padding="8" Text="3" TextChanged="Property_Changed" />
                            </StackPanel>
                            <StackPanel x:Name="RepeatDurationSettings">
                                <TextBlock Text="繰り返す時間（秒）" Foreground="{StaticResource MutedBrush}" />
                                <TextBox x:Name="RepeatDurationBox" Margin="0,5,0,12" Padding="8" Text="10" TextChanged="Property_Changed" />
                                <TextBlock Text="指定時間が経過した後、実行中の内部操作一巡が終わると停止します。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            </StackPanel>
                            <TextBlock Text="この繰り返しに操作を追加するには、左側の操作ボタンを押してください。繰り返し行を選択してから追加すると、その内部に追加されます。繰り返しを入れ子にすることもできます。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Background="#FF292D37" CornerRadius="8" Padding="10" Margin="0,16,0,0">
                            <TextBlock Text="階層表示の操作は、左側の追加・移動・複製・削除ボタンで編集できます。" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#FF20232B" CornerRadius="10" Padding="10" Margin="0,12,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="StartRecordingButton" Content="● 記録開始" Click="StartRecording_Click" Background="#FFC04B55" Foreground="White" />
                    <Button x:Name="StopRecordingButton" Content="■ 記録停止" Click="StopRecording_Click" IsEnabled="False" />
                    <Button Content="▶ 実行" Click="Run_Click" Background="#FF2F9E72" Foreground="White" />
                    <Button Content="Ⅱ 一時停止" Click="Pause_Click" />
                    <Button Content="■ 停止" Click="Stop_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Text="準備完了：操作を追加してマクロを組み立ててください。" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="　｜　停止ホットキー：Ctrl + Alt + S" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>

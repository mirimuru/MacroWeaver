<Window x:Class="MacroWeaver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MacroWeaver" Height="760" Width="1240" MinHeight="620" MinWidth="980"
        WindowStartupLocation="CenterScreen" Background="#FF17191F" Foreground="#FFF3F4F8">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FF20232B" CornerRadius="12" Padding="16" Margin="0,0,0,12">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="📂 読み込み" Click="Load_Click" />
                    <Button Content="💾 保存" Click="Save_Click" Background="#FF5B6EE1" Foreground="White" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="MacroWeaver" FontSize="24" FontWeight="Bold" />
                    <TextBlock Text="視覚的に組み立てる Windows マクロエディター" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#FF20232B" CornerRadius="12" Padding="12" Margin="0,0,12,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="操作を追加" FontSize="16" FontWeight="SemiBold" Margin="4,4,4,12" />
                    <StackPanel>
                        <Button Content="⌨  キー入力" Click="AddKey_Click" HorizontalContentAlignment="Left" />
                        <Button Content="🖱  マウスクリック" Click="AddClick_Click" HorizontalContentAlignment="Left" />
                        <Button Content="↗  マウス移動" Click="AddMove_Click" HorizontalContentAlignment="Left" />
                        <Button Content="⏱  待機" Click="AddWait_Click" HorizontalContentAlignment="Left" />
                        <Button Content="🔁  繰り返し" Click="AddRepeat_Click" HorizontalContentAlignment="Left" />
                        <Separator Margin="3,12" />
                        <Button Content="↑  上へ移動" Click="MoveUp_Click" HorizontalContentAlignment="Left" />
                        <Button Content="↓  下へ移動" Click="MoveDown_Click" HorizontalContentAlignment="Left" />
                        <Button Content="⧉  複製" Click="Duplicate_Click" HorizontalContentAlignment="Left" />
                        <Button Content="－  削除" Click="Delete_Click" HorizontalContentAlignment="Left" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="操作を選択すると、右側で詳細を編集できます。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="4,12,4,4" />
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Background="#FF20232B" CornerRadius="12" Padding="12" Margin="0,0,12,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,4,4,12">
                        <TextBlock Text="マクロの手順" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock x:Name="StepCountText" Text="0 操作" Foreground="{StaticResource MutedBrush}" Margin="12,2,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <DataGrid x:Name="StepsGrid" ItemsSource="{Binding Steps}" SelectedItem="{Binding SelectedStep, Mode=TwoWay}"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              SelectionMode="Single" SelectionUnit="FullRow" GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column" Background="#FF292D37" Foreground="#FFF3F4F8"
                              BorderThickness="0" RowBackground="#FF292D37" AlternatingRowBackground="#FF252832"
                              HorizontalGridLinesBrush="#FF3A3E49" VerticalGridLinesBrush="#FF3A3E49"
                              SelectionChanged="StepsGrid_SelectionChanged">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#FF343844" />
                                <Setter Property="Foreground" Value="#FFE5E7EF" />
                                <Setter Property="Padding" Value="10,9" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="8,7" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Foreground" Value="#FFF3F4F8" />
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding OrderLabel}" Width="44" IsReadOnly="True" />
                            <DataGridTextColumn Header="操作" Binding="{Binding TypeLabel}" Width="150" IsReadOnly="True" />
                            <DataGridTextColumn Header="名前" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            <DataGridTextColumn Header="設定" Binding="{Binding Summary}" Width="190" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Background="#FF20232B" CornerRadius="12" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="プロパティ" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14" />
                        <TextBlock Text="操作名" Foreground="{StaticResource MutedBrush}" />
                        <TextBox x:Name="NameBox" Margin="0,5,0,14" Padding="8" TextChanged="Property_Changed" />

                        <StackPanel x:Name="KeyPanel" Visibility="Collapsed">
                            <TextBlock Text="キー" Foreground="{StaticResource MutedBrush}" />
                            <TextBox x:Name="KeyBox" Margin="0,5,0,12" Padding="8" Text="A" TextChanged="Property_Changed" />
                            <TextBlock Text="押下時間（秒）" Foreground="{StaticResource MutedBrush}" />
                            <TextBox x:Name="KeySecondsBox" Margin="0,5,0,12" Padding="8" Text="0.1" TextChanged="Property_Changed" />
                        </StackPanel>

                        <StackPanel x:Name="ClickPanel" Visibility="Collapsed">
                            <TextBlock Text="マウスボタン" Foreground="{StaticResource MutedBrush}" />
                            <ComboBox x:Name="MouseButtonBox" Margin="0,5,0,12" Padding="6" SelectionChanged="Property_SelectionChanged">
                                <ComboBoxItem Content="Left" />
                                <ComboBoxItem Content="Right" />
                                <ComboBoxItem Content="Middle" />
                            </ComboBox>
                            <TextBlock Text="クリック回数" Foreground="{StaticResource MutedBrush}" />
                            <TextBox x:Name="ClickCountBox" Margin="0,5,0,12" Padding="8" Text="1" TextChanged="Property_Changed" />
                        </StackPanel>

                        <StackPanel x:Name="MovePanel" Visibility="Collapsed">
                            <TextBlock Text="X 座標" Foreground="{StaticResource MutedBrush}" />
                            <TextBox x:Name="XBox" Margin="0,5,0,12" Padding="8" Text="500" TextChanged="Property_Changed" />
                            <TextBlock Text="Y 座標" Foreground="{StaticResource MutedBrush}" />
                            <TextBox x:Name="YBox" Margin="0,5,0,12" Padding="8" Text="300" TextChanged="Property_Changed" />
                        </StackPanel>

                        <StackPanel x:Name="WaitPanel" Visibility="Collapsed">
                            <TextBlock Text="待機時間（秒）" Foreground="{StaticResource MutedBrush}" />
                            <TextBox x:Name="WaitSecondsBox" Margin="0,5,0,12" Padding="8" Text="1" TextChanged="Property_Changed" />
                        </StackPanel>

                        <StackPanel x:Name="RepeatPanel" Visibility="Collapsed">
                            <TextBlock Text="繰り返し回数（0 = 無限）" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                            <TextBox x:Name="RepeatCountBox" Margin="0,5,0,12" Padding="8" Text="3" TextChanged="Property_Changed" />
                            <TextBlock Text="注：入れ子の手順編集は次の開発段階で対応します。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Background="#FF292D37" CornerRadius="8" Padding="10" Margin="0,16,0,0">
                            <TextBlock Text="入力の自動送信・記録・実行エンジンは段階的に追加します。" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#FF20232B" CornerRadius="10" Padding="10" Margin="0,12,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="▶ 実行" Click="Run_Click" Background="#FF2F9E72" Foreground="White" />
                    <Button Content="Ⅱ 一時停止" Click="Pause_Click" />
                    <Button Content="■ 停止" Click="Stop_Click" />
                </StackPanel>
                <TextBlock x:Name="StatusText" Text="準備完了：操作を追加してマクロを組み立ててください。" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
